{
  "name": "RecoBundles X",
  "github": "gamorosino/app-recobundles-x",
  "github_branch": "v0.1.0",
  "config": {
    "track": {
      "type": "input",
      "file_id": "track",
      "input_id": "track"
    },
    "t1": {
      "type": "input",
      "file_id": "t1",
      "input_id": "anat"
    },
    "atlas": {
      "id": "atlas",
      "type": "enum",
      "placeholder": "",
      "advanced": false,
      "desc": "Atlas version to download from Zenodo at runtime. v3.0 = Zenodo 7950602 (RecobundlesX \u2192 BundleSeg transition); v2.2 = Zenodo 7729059; v2.0 = Zenodo 7562635.",
      "default": "v3.0",
      "options": [
        {
          "value": "v3.0",
          "label": "v3.0 (Zenodo 7950602 \u2014 recommended)"
        },
        {
          "value": "v2.2",
          "label": "v2.2 (Zenodo 7729059)"
        },
        {
          "value": "v2.0",
          "label": "v2.0 (Zenodo 7562635)"
        }
      ]
    },
    "minL": {
      "id": "minL",
      "type": "number",
      "placeholder": "",
      "advanced": false,
      "desc": "Minimum streamline length (mm). Streamlines shorter than this are discarded before bundle recognition.",
      "default": 20
    },
    "maxL": {
      "id": "maxL",
      "type": "number",
      "placeholder": "",
      "advanced": false,
      "desc": "Maximum streamline length (mm). Streamlines longer than this are discarded before bundle recognition.",
      "default": 200
    },
    "seeds": {
      "id": "seeds",
      "type": "number",
      "placeholder": "",
      "advanced": false,
      "desc": "Random number generator seed for reproducibility.",
      "default": 0
    },
    "minimal_vote_ratio": {
      "id": "minimal_vote_ratio",
      "type": "number",
      "placeholder": "",
      "advanced": false,
      "desc": "Minimum fraction of multi-parameter runs in which a streamline must be recognized to be kept in the final bundle.",
      "default": 0.5
    },
    "processes": {
      "id": "processes",
      "type": "number",
      "placeholder": "",
      "advanced": true,
      "desc": "Number of parallel threads.",
      "default": 1
    }
  },
  "inputs": [
    {
      "id": "track",
      "desc": "Whole-brain tractogram in TrackVis (.trk) format.",
      "datatype": "neuro/track/trk",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "advanced": false
    },
    {
      "id": "anat",
      "desc": "Subject T1-weighted anatomy used for ANTs affine registration to the atlas space.",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "advanced": false
    }
  ],
  "outputs": [
    {
      "id": "wmc",
      "desc": "White matter classification: recognized bundle assignments for each streamline.",
      "datatype": "neuro/wmc",
      "datatype_tags": [],
      "archive": true
    },
    {
      "id": "tcks",
      "desc": "Recognized bundles as a collection of MRtrix (.tck) files, one per bundle.",
      "datatype": "neuro/tcks",
      "datatype_tags": [],
      "archive": true
    }
  ]
}
